# Server Port
PORT=5000

# Database Configuration (SQLite default for local dev, PostgreSQL for production)
# SQLite: file:./dev.db
# PostgreSQL: postgresql://postgres:password@localhost:5432/jobstudent?schema=public
DATABASE_URL="file:./dev.db"

# JWT Secret Key for token signing
JWT_SECRET="your-strong-jwt-secret-key-here"

# Frontend Client URL for CORS
CLIENT_URL="http://localhost:5173"

# Email Integration (Optional)
EMAIL_SERVICE_ENABLED=false
EMAIL_FROM="noreply@jobstudent.vn"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Uploads directory
UPLOAD_DIR="./uploads"
